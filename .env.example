# Hauptadmin – wird nur beim allerersten Start angelegt. Leer lassen für den
# Standard-Login admin/admin (Passwort muss beim ersten Login geändert werden).
# Hash mit:  node scripts/hash-password.mjs "DEIN-PASSWORT"
ADMIN_USER=
ADMIN_PASSWORD_HASH=
# Zufälliger String, z.B.:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=REPLACE_ME
# Öffentliche URL (bestimmt u.a. secure-Cookie und QR-Ziel)
BASE_URL=https://helfer.example.org
PORT=8080
DB_PATH=/data/app.db
# Zeitzone der Veranstaltung (fürs Ausblenden vergangener Schichten)
TIMEZONE=Europe/Berlin
# Link zum Quellcode in der Fußzeile (AGPL: wer das Tool verändert und öffentlich
# betreibt, muss den geänderten Code anbieten). Leer = kein Link.
SOURCE_URL=
