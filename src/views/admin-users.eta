<div class="admin">
  <div class="admin-bar">
    <h2>Benutzer</h2>
    <div class="admin-actions"><a href="/admin">← Dashboard</a> · <a href="/admin/settings">Einstellungen</a></div>
  </div>
  <% if (it.notice) { %><p class="saved"><%= it.notice %></p><% } %>
  <% if (it.errors && it.errors.length) { %>
    <div class="errors"><% it.errors.forEach(function(e){ %><p><%= e %></p><% }) %></div>
  <% } %>

  <% it.users.forEach(function(u){ %>
    <section class="user-card">
      <% if (u.is_owner) { %>
        <h3><%= u.username %> <span class="orga-badge">Hauptadmin</span></h3>
        <p class="hint">Darf alles, inklusive Benutzer verwalten und alles zurücksetzen.
          <a href="/admin/password">Eigenes Passwort ändern</a></p>
      <% } else { %>
        <details>
          <summary><strong><%= u.username %></strong>
            <span class="hint">· <%= u.perms.length ? u.perms.length + ' Rechte' : 'nur ansehen' %>
              · <%= u.areaIds == null ? 'alle Bereiche' : u.areaIds.length + ' Bereich(e)' %>
              <% if (u.must_change_password) { %>· muss Passwort noch ändern<% } %></span>
          </summary>
          <form method="post" action="/admin/users/<%= u.id %>" class="shift-form">
            <input type="hidden" name="csrf" value="<%= it.csrf %>">
            <label>Benutzername <input name="username" value="<%= u.username %>" required maxlength="50"></label>
            <%~ include('admin-user-access', { permissions: it.permissions, areas: it.areas, perms: u.perms, areaScope: u.areaIds == null ? 'all' : 'some', areaIds: u.areaIds }) %>
            <button type="submit">Speichern</button>
          </form>
          <form method="post" action="/admin/users/<%= u.id %>/password" class="signup-form">
            <input type="hidden" name="csrf" value="<%= it.csrf %>">
            <input type="text" name="password" placeholder="Neues Passwort (mind. 8 Zeichen)" minlength="8" required autocomplete="off">
            <button type="submit">Passwort neu setzen</button>
          </form>
          <form method="post" action="/admin/users/<%= u.id %>/delete" class="inline"
                onsubmit="return confirm('Diesen Account wirklich löschen?')">
            <input type="hidden" name="csrf" value="<%= it.csrf %>">
            <button type="submit" class="danger">Account löschen</button>
          </form>
        </details>
      <% } %>
    </section>
  <% }) %>

  <h3>Neuen Account anlegen</h3>
  <form method="post" action="/admin/users" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <label>Benutzername <input name="username" value="<%= it.values.username || '' %>" required maxlength="50" autocomplete="off"></label>
    <label>Start-Passwort (mind. 8 Zeichen, muss beim ersten Login geändert werden)
      <input type="text" name="password" required minlength="8" autocomplete="off"></label>
    <%~ include('admin-user-access', { permissions: it.permissions, areas: it.areas, perms: it.values.perms, areaScope: it.values.area_scope, areaIds: it.values.areas }) %>
    <button type="submit">Account anlegen</button>
  </form>
</div>
