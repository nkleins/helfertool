<div class="admin-login">
  <h2><%= it.t('orga.loginTitle') %></h2>
  <p class="hint"><%= it.t('orga.loginText') %></p>
  <% if (it.error) { %><p class="errors"><%= it.t(it.error) %></p><% } %>
  <form method="post" action="/orga/login">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <input type="password" name="password" placeholder="<%= it.t('orga.password') %>" required autocomplete="current-password">
    <button type="submit"><%= it.t('orga.submit') %></button>
  </form>
  <p><a href="/"><%= it.t('thanks.back') %></a></p>
</div>
