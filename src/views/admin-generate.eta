<div class="admin">
  <%~ include('admin-back', { t: it.t, heading: it.t('gen.title') }) %>
  <%~ include('errors', it) %>
  <% if (!it.areas.length) { %>
    <p><%~ it.t('gen.needArea') %></p>
  <% } else { %>
  <form method="post" action="/admin/shifts/generate" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <div class="orga-toggle <%= it.values.is_orga ? 'is-on' : '' %>">
      <label class="checkbox">
        <input type="checkbox" name="is_orga" value="1" <%= it.values.is_orga ? 'checked' : '' %>>
        <span><%~ it.t('gen.orga') %></span>
      </label>
    </div>
    <label><%= it.t('shift.area') %>
      <select name="area_id" required>
        <% it.areas.forEach(function(a){ %>
          <option value="<%= a.id %>" <%= String(a.id) === String(it.values.area_id) ? 'selected' : '' %>><%= a.name %></option>
        <% }) %>
      </select>
    </label>
    <label><%= it.t('shift.titleOptional') %> <input name="title" value="<%= it.values.title || '' %>" maxlength="500"></label>
    <label><%= it.t('gen.date') %> <input type="date" name="date" value="<%= it.values.date || '' %>" required></label>
    <%
      var halfHours = [];
      for (var h = 0; h < 24; h++) {
        for (var mm = 0; mm < 60; mm += 30) {
          halfHours.push(('0' + h).slice(-2) + ':' + ('0' + mm).slice(-2));
        }
      }
    %>
    <label><%= it.t('gen.from') %>
      <select name="from" required>
        <option value="">–</option>
        <% halfHours.forEach(function(t){ %>
          <option value="<%= t %>" <%= t === it.values.from ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <label><%= it.t('gen.to') %>
      <select name="to" required>
        <option value="">–</option>
        <% halfHours.forEach(function(t){ %>
          <option value="<%= t %>" <%= t === it.values.to ? 'selected' : '' %>><%= t %></option>
        <% }) %>
      </select>
    </label>
    <p class="hint"><%= it.t('gen.midnightHint') %></p>
    <label><%= it.t('gen.slotLength') %>
      <select name="slot_minutes">
        <% it.slotOptions.forEach(function(m){ %>
          <option value="<%= m %>" <%= String(m) === String(it.values.slot_minutes) ? 'selected' : '' %>><%= m %> min<%= m % 60 === 0 ? ' (' + it.t('gen.hours', { n: m / 60 }) + ')' : '' %></option>
        <% }) %>
      </select>
    </label>
    <label><%= it.t('gen.capacity') %> <input type="number" min="1" name="capacity" value="<%= it.values.capacity || 2 %>" required></label>
    <label class="checkbox"><input type="checkbox" name="requires_phone" value="1" <%= it.values.requires_phone ? 'checked' : '' %>> <%= it.t('shift.requiresPhone') %></label>
    <label><%= it.t('gen.notes') %> <input name="notes" value="<%= it.values.notes || '' %>" maxlength="500"></label>
    <%~ include('admin-en-fields', { t: it.t, title_en: it.values.title_en, notes_en: it.values.notes_en }) %>
    <button type="submit"><%= it.t('gen.submit') %></button>
  </form>
  <% } %>
</div>
