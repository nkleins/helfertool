<% var has = function (list, v) { return [].concat(list || []).map(String).indexOf(String(v)) !== -1; }; %>
<fieldset>
  <legend><%= it.t('access.may') %></legend>
  <% it.permissions.forEach(function (p) { %>
    <label class="checkbox"><input type="checkbox" name="perms" value="<%= p %>"<%= has(it.perms, p) ? ' checked' : '' %>> <%= it.t('perm.' + p) %></label>
  <% }) %>
  <p class="hint"><%= it.t('access.everyone') %></p>
</fieldset>
<fieldset>
  <legend><%= it.t('access.areas') %></legend>
  <label class="checkbox"><input type="radio" name="area_scope" value="all"<%= it.areaScope !== 'some' ? ' checked' : '' %>> <%= it.t('access.allAreas') %></label>
  <label class="checkbox"><input type="radio" name="area_scope" value="some"<%= it.areaScope === 'some' ? ' checked' : '' %>> <%= it.t('access.someAreas') %></label>
  <% if (!it.areas.length) { %><p class="hint"><%= it.t('access.noAreas') %></p><% } %>
  <% it.areas.forEach(function (a) { %>
    <label class="checkbox area-pick"><input type="checkbox" name="areas" value="<%= a.id %>"<%= has(it.areaIds, a.id) ? ' checked' : '' %>> <span class="dot" style="background:<%= a.color %>"></span> <%= a.name %></label>
  <% }) %>
</fieldset>
