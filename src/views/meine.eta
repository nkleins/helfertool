<div class="meine">
  <div class="admin-bar">
    <h2><%= it.t('title.mine') %></h2>
    <div class="admin-actions"><a href="/"><%= it.t('mine.back') %></a></div>
  </div>
  <% if (!it.items.length) { %>
    <p class="empty"><%~ it.t('mine.empty') %></p>
    <p class="hint"><%= it.t('mine.otherDevice') %></p>
  <% } else { %>
    <ul class="mine-list">
      <% it.items.forEach(function(s){ %>
        <li class="mine-item" style="--area-color:<%= s.area_color %>">
          <div>
            <span class="dot" style="background:<%= s.area_color %>"></span>
            <strong><%= s.area_name %></strong><% if (s.title) { %> · <%= s.title %><% } %>
            <div class="mine-time"><%= s.dayLabel %>, <%= s.time %></div>
            <div class="mine-name"><%= it.t('mine.signedUpAs') %> <strong><%= s.name %></strong></div>
          </div>
          <form method="post" action="/signup/<%= s.signup_id %>/cancel" class="inline"
                data-confirm="<%= it.t('mine.cancelConfirm') %>"
                onsubmit="return confirm(this.dataset.confirm)">
            <input type="hidden" name="csrf" value="<%= it.csrf %>">
            <button type="submit" class="danger"><%= it.t('mine.cancel') %></button>
          </form>
        </li>
      <% }) %>
    </ul>
    <p class="hint"><%= it.t('mine.hint') %></p>
  <% } %>
</div>
