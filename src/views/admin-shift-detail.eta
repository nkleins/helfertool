<div class="admin">
  <%~ include('admin-back', { t: it.t, heading: (it.shift.title || it.t('shift.untitled')) + ' (' + it.shift.area_name + ')' }) %>
  <p><%= it.when %> · <%= it.t('detail.taken', { taken: it.signups.length, capacity: it.shift.capacity }) %></p>
  <% if (it.can('shifts')) { %>
  <div class="admin-actions">
    <a href="/admin/shifts/<%= it.shift.id %>/edit"><%= it.t('detail.edit') %></a>
    <form method="post" action="/admin/shifts/<%= it.shift.id %>/delete" class="inline"
          data-confirm="<%= it.t('detail.deleteConfirm') %>" onsubmit="return confirm(this.dataset.confirm)">
      <input type="hidden" name="csrf" value="<%= it.csrf %>">
      <button type="submit" class="danger"><%= it.t('detail.delete') %></button>
    </form>
  </div>
  <% } %>

  <%~ include('errors', it) %>

  <h3><%= it.t('detail.people') %></h3>
  <% if (!it.signups.length) { %><p class="hint"><%= it.t('detail.nobody') %></p><% } %>
  <% if (!it.can('signups')) { %>
  <ul class="signups-list">
  <% it.signups.forEach(function(g){ %>
    <li class="signup-row"><strong><%= g.name %></strong><% if (g.phone) { %> · <%= g.phone %><% } %><% if (g.note) { %> · <span class="hint"><%= g.note %></span><% } %></li>
  <% }) %>
  </ul>
  <% } else { %>
  <ul class="signups-list">
  <% it.signups.forEach(function(g){ %>
    <li class="signup-row">
      <form method="post" action="/admin/signups/<%= g.id %>" class="signup-form">
        <input type="hidden" name="csrf" value="<%= it.csrf %>">
        <input type="text" name="name" value="<%= g.name %>" required maxlength="500" aria-label="<%= it.t('detail.name') %>" placeholder="<%= it.t('detail.name') %>">
        <input type="tel" name="phone" value="<%= g.phone || '' %>" maxlength="500" aria-label="<%= it.t('detail.phone') %>" placeholder="<%= it.t('detail.phone') %>">
        <input type="text" name="note" value="<%= g.note || '' %>" maxlength="500" aria-label="<%= it.t('detail.note') %>" placeholder="<%= it.t('detail.note') %>">
        <button type="submit"><%= it.t('common.save') %></button>
      </form>
      <form method="post" action="/admin/signups/<%= g.id %>/delete" class="inline"
            data-confirm="<%= it.t('detail.removeConfirm') %>" onsubmit="return confirm(this.dataset.confirm)">
        <input type="hidden" name="csrf" value="<%= it.csrf %>">
        <button type="submit" class="danger"><%= it.t('detail.remove') %></button>
      </form>
    </li>
  <% }) %>
  </ul>

  <h3><%= it.t('detail.addTitle') %></h3>
  <form method="post" action="/admin/shifts/<%= it.shift.id %>/signups" class="signup-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <input type="text" name="name" placeholder="<%= it.t('detail.name') %>" required maxlength="500">
    <input type="tel" name="phone" placeholder="<%= it.t('detail.phoneOptional') %>" maxlength="500">
    <input type="text" name="note" placeholder="<%= it.t('detail.noteOptional') %>" maxlength="500">
    <button type="submit"><%= it.t('detail.add') %></button>
  </form>
  <% } %>
</div>
