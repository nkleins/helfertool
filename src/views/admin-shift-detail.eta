<div class="admin">
  <div class="admin-bar">
    <h2><%= it.shift.title || 'Schicht' %> <small class="hint">(<%= it.shift.area_name %>)</small></h2>
    <div class="admin-actions"><a href="/admin">← Dashboard</a></div>
  </div>
  <p><%= it.when %> · <%= it.signups.length %>/<%= it.shift.capacity %> belegt</p>
  <% if (it.can('shifts')) { %>
  <div class="admin-actions">
    <a href="/admin/shifts/<%= it.shift.id %>/edit">Schicht bearbeiten</a>
    <form method="post" action="/admin/shifts/<%= it.shift.id %>/delete" class="inline"
          onsubmit="return confirm('Schicht wirklich löschen? Alle Eintragungen gehen verloren.')">
      <input type="hidden" name="csrf" value="<%= it.csrf %>">
      <button type="submit" class="danger">Schicht löschen</button>
    </form>
  </div>
  <% } %>

  <%~ include('errors', it) %>

  <h3>Eingetragene Helfer:innen</h3>
  <% if (!it.signups.length) { %><p class="hint">Noch niemand eingetragen.</p><% } %>
  <% if (!it.can('signups')) { %>
  <ul class="signups-list">
  <% it.signups.forEach(function(g){ %>
    <li class="signup-row"><strong><%= g.name %></strong><% if (g.phone) { %> · <%= g.phone %><% } %><% if (g.note) { %> · <span class="hint"><%= g.note %></span><% } %></li>
  <% }) %>
  </ul>
  <% } else { %>
  <ul class="signups-list">
  <% it.signups.forEach(function(g){ %>
    <li class="signup-row">
      <form method="post" action="/admin/signups/<%= g.id %>" class="signup-form">
        <input type="hidden" name="csrf" value="<%= it.csrf %>">
        <input type="text" name="name" value="<%= g.name %>" required maxlength="500" aria-label="Name" placeholder="Name">
        <input type="tel" name="phone" value="<%= g.phone || '' %>" maxlength="500" aria-label="Telefon" placeholder="Telefon">
        <input type="text" name="note" value="<%= g.note || '' %>" maxlength="500" aria-label="Notiz" placeholder="Notiz">
        <button type="submit">Speichern</button>
      </form>
      <form method="post" action="/admin/signups/<%= g.id %>/delete" class="inline"
            onsubmit="return confirm('Eintrag entfernen?')">
        <input type="hidden" name="csrf" value="<%= it.csrf %>">
        <button type="submit" class="danger">entfernen</button>
      </form>
    </li>
  <% }) %>
  </ul>

  <h3>Helfer:in manuell hinzufügen</h3>
  <form method="post" action="/admin/shifts/<%= it.shift.id %>/signups" class="signup-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <input type="text" name="name" placeholder="Name" required maxlength="500">
    <input type="tel" name="phone" placeholder="Telefon (optional)" maxlength="500">
    <input type="text" name="note" placeholder="Notiz (optional)" maxlength="500">
    <button type="submit">Hinzufügen</button>
  </form>
  <% } %>
</div>
