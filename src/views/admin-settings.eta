<div class="admin">
  <div class="admin-bar">
    <h2>Einstellungen</h2>
    <div class="admin-actions"><a href="/admin">← Dashboard</a> · <a href="/admin/password">Mein Passwort ändern</a><% if (it.me.is_owner) { %> · <a href="/admin/users">Benutzer verwalten</a><% } %></div>
  </div>
  <% if (it.saved) { %><p class="saved">Gespeichert.</p><% } %>
  <%~ include('errors', it) %>

  <% if (!it.can('settings_edit')) { %><p class="hint">Du kannst die Einstellungen nur ansehen.</p><% } %>
  <form method="post" action="/admin/settings" enctype="multipart/form-data" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <fieldset class="plain"<%= it.can('settings_edit') ? '' : ' disabled' %>>

    <label>Name der Seite / Veranstaltung
      <input name="event_name" value="<%= it.values.event_name %>" required maxlength="500"
             placeholder="z.B. Disco-Dienste">
    </label>
    <label>Name der Con / des Vereins (optional)
      <input name="org_name" value="<%= it.values.org_name %>" maxlength="500" placeholder="z.B. Meine Convention">
    </label>
    <label>Motto / Datum unter der Überschrift (optional)
      <input name="motto" value="<%= it.values.motto %>" maxlength="500" placeholder="z.B. 25.–27.09.26">
    </label>
    <label>Fußzeile (optional)
      <input name="footer" value="<%= it.values.footer %>" maxlength="500" placeholder="z.B. Mein Verein e.V.">
    </label>
    <label>Akzentfarbe
      <input type="color" name="accent_color" value="<%= it.values.accent_color %>">
    </label>

    <fieldset>
      <legend>Logo</legend>
      <img src="/logo?preview=<%= Date.now() %>" alt="Aktuelles Logo" class="logo-preview"
           onerror="this.style.display='none'">
      <label class="checkbox"><input type="checkbox" name="show_logo" value="1"
        <%= it.values.show_logo === '1' ? 'checked' : '' %>> Logo im Kopfbereich anzeigen</label>
      <label>Neues Logo hochladen (PNG, JPG, GIF oder WebP, max. 2 MB)
        <input type="file" name="logo" accept="image/png,image/jpeg,image/gif,image/webp">
      </label>
      <% if (it.hasCustomLogo) { %>
        <label class="checkbox"><input type="checkbox" name="remove_logo" value="1">
          Hochgeladenes Logo entfernen (Standard-Logo verwenden)</label>
      <% } %>
    </fieldset>

    <% if (it.can('settings_edit')) { %><button type="submit">Speichern</button><% } %>
    </fieldset>
  </form>

  <% if (it.me.is_owner) { %>
  <section class="danger-zone" id="reset">
    <h3>Neu anfangen (für die nächste Con)</h3>
    <% if (it.resetDone) { %><p class="saved">Alle Schichten und Anmeldungen wurden gelöscht.</p><% } %>
    <%~ include('errors', { errors: it.resetErrors }) %>
    <p>Löscht <strong>alle Schichten und alle Anmeldungen</strong> endgültig. Name, Logo und
      Einstellungen bleiben erhalten. Tipp: vorher den <a href="/admin/export.csv">CSV-Export</a> sichern.</p>
    <form method="post" action="/admin/reset" class="shift-form"
          onsubmit="return confirm('Wirklich alles löschen? Das kann nicht rückgängig gemacht werden.')">
      <input type="hidden" name="csrf" value="<%= it.csrf %>">
      <label class="checkbox"><input type="checkbox" name="include_areas" value="1">
        Auch alle Bereiche löschen</label>
      <label>Zum Bestätigen „<%= it.resetPhrase %>" eintippen
        <input name="confirm" autocomplete="off" required placeholder="<%= it.resetPhrase %>"
               pattern="\s*[Aa][Ll][Ll][Ee][Ss] [Ll][Öö][Ss][Cc][Hh][Ee][Nn]\s*"
               title="Bitte genau „<%= it.resetPhrase %>" eintippen">
      </label>
      <button type="submit" class="danger">Alles löschen</button>
    </form>
  </section>
  <% } %>
</div>
