<!doctype html>
<html lang="<%= it.lang %>">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= it.title %> · <%= it.brand.event_name %></title>
  <link rel="stylesheet" href="/styles.css">
  <link rel="icon" href="<%= it.brand.logoUrl %>">
  <style>:root { --accent: <%= it.brand.accent_color %>; }</style>
</head>
<body>
  <header class="site-header">
    <% if (it.langSwitch) { %>
    <a class="lang-switch" href="/lang/<%= it.lang === 'de' ? 'en' : 'de' %>?back=<%= encodeURIComponent(it.path || '/') %>"
       lang="<%= it.lang === 'de' ? 'en' : 'de' %>" title="<%= it.t('lang.switch') %>"><%= it.t('lang.switchShort') %></a>
    <% } %>
    <% if (it.brand.show_logo === '1') { %>
    <img src="<%= it.brand.logoUrl %>" alt="<%= it.brand.org_name || it.brand.event_name %>" class="logo"
         onerror="this.style.display='none'">
    <% } %>
    <h1><%= it.brand.event_name %><% if (it.brand.org_name) { %> · <%= it.brand.org_name %><% } %></h1>
    <% if (it.brand.motto) { %><p class="motto"><%= it.brand.motto %></p><% } %>
  </header>
  <main><%~ it.body %></main>
  <footer class="site-footer">
    <% if (it.brand.footer) { %><div><%= it.brand.footer %></div><% } %>
    <div class="credit">Helfertool © <%= new Date().getFullYear() %> Nikolai Kleinschmidt
      <% if (it.sourceUrl) { %>· <a href="<%= it.sourceUrl %>" rel="noopener">Quellcode (AGPL)</a><% } %></div>
  </footer>
</body>
</html>
