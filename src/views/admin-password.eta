<div class="admin">
  <div class="admin-bar">
    <h2><%= it.t('pw.title') %></h2>
    <% if (!it.me.must_change_password) { %><div class="admin-actions"><a href="/admin"><%= it.t('nav.back') %></a></div><% } %>
  </div>
  <% if (it.me.must_change_password) { %>
    <p class="errors"><%= it.t(it.me.is_owner ? 'pw.mustChangeOwner' : 'pw.mustChange') %></p>
  <% } %>
  <% if (it.saved) { %><p class="saved"><%= it.t('pw.saved') %></p><% } %>
  <%~ include('errors', it) %>
  <p class="hint"><%= it.t(it.me.is_owner ? 'pw.loggedInOwner' : 'pw.loggedIn', { user: it.me.username }) %></p>
  <form method="post" action="/admin/password" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <input type="text" name="username" value="<%= it.me.username %>" autocomplete="username" hidden>
    <label><%= it.t('pw.current') %>
      <input type="password" name="current" required autocomplete="current-password"></label>
    <label><%= it.t('pw.new') %>
      <input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <label><%= it.t('pw.repeat') %>
      <input type="password" name="password2" required minlength="8" autocomplete="new-password"></label>
    <button type="submit"><%= it.t('pw.submit') %></button>
  </form>
  <% if (it.me.must_change_password) { %>
    <form method="post" action="/admin/logout" class="inline">
      <input type="hidden" name="csrf" value="<%= it.csrf %>"><button type="submit" class="danger"><%= it.t('pw.cancel') %></button>
    </form>
  <% } %>
</div>
