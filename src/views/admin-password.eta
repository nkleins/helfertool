<div class="admin">
  <div class="admin-bar">
    <h2>Passwort ändern</h2>
    <% if (!it.me.must_change_password) { %><div class="admin-actions"><a href="/admin">← Dashboard</a></div><% } %>
  </div>
  <% if (it.me.must_change_password) { %>
    <p class="errors">Bitte lege zuerst ein eigenes Passwort fest<% if (it.me.is_owner) { %> – das Standardpasswort „admin" ist unsicher<% } %>.</p>
  <% } %>
  <% if (it.saved) { %><p class="saved">Passwort geändert. Andere Geräte wurden abgemeldet.</p><% } %>
  <%~ include('errors', it) %>
  <p class="hint">Angemeldet als <strong><%= it.me.username %></strong><% if (it.me.is_owner) { %> (Hauptadmin)<% } %>.</p>
  <form method="post" action="/admin/password" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <input type="text" name="username" value="<%= it.me.username %>" autocomplete="username" hidden>
    <label>Aktuelles Passwort
      <input type="password" name="current" required autocomplete="current-password"></label>
    <label>Neues Passwort (mind. 8 Zeichen)
      <input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
    <label>Neues Passwort wiederholen
      <input type="password" name="password2" required minlength="8" autocomplete="new-password"></label>
    <button type="submit">Passwort speichern</button>
  </form>
  <% if (it.me.must_change_password) { %>
    <form method="post" action="/admin/logout" class="inline">
      <input type="hidden" name="csrf" value="<%= it.csrf %>"><button type="submit" class="danger">Abbrechen &amp; ausloggen</button>
    </form>
  <% } %>
</div>
