<div class="admin">
  <div class="admin-bar">
    <h2>Dashboard</h2>
    <%~ include('admin-nav', it) %>
  </div>

  <section class="progress">
    <% it.stats.forEach(function(a){ var pct = a.capacity ? Math.round(a.taken*100/a.capacity) : 0; %>
      <div class="progress-row">
        <span class="dot" style="background:<%= a.color %>"></span>
        <strong><%= a.name %></strong>
        <span class="bar"><span class="bar-fill" style="width:<%= pct %>%;background:<%= a.color %>"></span></span>
        <span class="pct"><%= pct %>% belegt (<%= a.taken %>/<%= a.capacity %>) · <%= a.gaps %> Lücken</span>
      </div>
    <% }) %>
  </section>

  <% if (!it.groups.length) { %><p>Noch keine Schichten.<% if (it.can('shifts')) { %> <a href="/admin/shifts/new">Jetzt erzeugen.</a><% } %></p><% } %>

  <% it.groups.forEach(function(g){ %>
    <section class="day-group">
      <div class="day-head">
        <h3><span class="dot" style="background:<%= g.area_color %>"></span> <%= g.area_name %> · <%= g.dayLabel %></h3>
        <% if (it.can('shifts')) { %>
        <form method="post" action="/admin/shifts/bulk-delete" class="inline"
              onsubmit="return confirm('Alle Schichten dieses Bereichs an diesem Tag löschen?')">
          <input type="hidden" name="csrf" value="<%= it.csrf %>">
          <input type="hidden" name="area_id" value="<%= g.area_id %>">
          <input type="hidden" name="day" value="<%= g.day %>">
          <button type="submit" class="danger">Tag löschen</button>
        </form>
        <% } %>
      </div>
      <table>
        <thead><tr><th>Zeit</th><th>Titel</th><th>Belegt</th><th>Eingetragen</th><th></th></tr></thead>
        <tbody>
        <% g.items.forEach(function(s){ %>
          <tr class="<%= s.free <= 0 ? 'row-full' : (s.taken > 0 ? 'row-part' : 'row-empty') %>">
            <td><%= s.time %></td>
            <td><%= s.title || '—' %><% if (s.is_orga) { %> <span class="orga-badge">Orga</span><% } %><% if (s.requires_phone) { %> <span class="req-badge">Tel-Pflicht</span><% } %></td>
            <td><%= s.taken %>/<%= s.capacity %></td>
            <td>
              <% if (s.people.length) { %>
                <ul class="who"><% s.people.forEach(function(p){ %><li><%= p.name %><% if (p.phone) { %> <span class="phone">· <%= p.phone %></span><% } %></li><% }) %></ul>
              <% } else { %>–<% } %>
            </td>
            <td><a href="/admin/shifts/<%= s.id %>">Details</a><% if (it.can('shifts')) { %> · <a href="/admin/shifts/<%= s.id %>/edit">Bearb.</a><% } %></td>
          </tr>
        <% }) %>
        </tbody>
      </table>
    </section>
  <% }) %>

  <% if (it.donateUrl) { %>
    <p class="hint donate">Das Helfertool ist kostenlos und ehrenamtlich entstanden. Wenn es euch hilft,
      freut sich der Entwickler über einen <a href="<%= it.donateUrl %>" target="_blank" rel="noopener">Kaffee ☕</a>.</p>
  <% } %>
</div>
