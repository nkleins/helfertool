<div class="admin">
  <%~ include('admin-back', { t: it.t, heading: it.t('shift.editTitle'), href: '/admin/shifts/' + it.shift.id, label: it.t('shift.backToShift') }) %>
  <%~ include('errors', it) %>
  <form method="post" action="<%= it.action %>" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <label><%= it.t('shift.area') %>
      <select name="area_id" required>
        <% it.areas.forEach(function(a){ %>
          <option value="<%= a.id %>" <%= String(a.id) === String(it.shift.area_id) ? 'selected' : '' %>><%= a.name %></option>
        <% }) %>
      </select>
    </label>
    <label><%= it.t('shift.titleOptional') %> <input name="title" value="<%= it.shift.title || '' %>" maxlength="500"></label>
    <label><%= it.t('shift.start') %> <input type="datetime-local" name="starts_at" value="<%= it.shift.starts_at %>" required></label>
    <label><%= it.t('shift.end') %> <input type="datetime-local" name="ends_at" value="<%= it.shift.ends_at %>" required></label>
    <label><%= it.t('shift.capacity') %> <input type="number" min="1" name="capacity" value="<%= it.shift.capacity %>" required></label>
    <label class="checkbox"><input type="checkbox" name="is_orga" value="1" <%= it.shift.is_orga ? 'checked' : '' %>> <%= it.t('shift.isOrga') %></label>
    <label class="checkbox"><input type="checkbox" name="requires_phone" value="1" <%= it.shift.requires_phone ? 'checked' : '' %>> <%= it.t('shift.requiresPhone') %></label>
    <label><%= it.t('shift.notes') %> <input name="notes" value="<%= it.shift.notes || '' %>" maxlength="500"></label>
    <%~ include('admin-en-fields', { t: it.t, title_en: it.shift.title_en, notes_en: it.shift.notes_en }) %>
    <button type="submit"><%= it.t('common.save') %></button>
  </form>
</div>
