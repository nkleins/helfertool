<div class="admin">
  <h2><%= it.title %></h2>
  <% if (it.errors && it.errors.length) { %>
    <div class="errors"><% it.errors.forEach(function(e){ %><p><%= e %></p><% }) %></div>
  <% } %>
  <form method="post" action="<%= it.action %>" class="shift-form">
    <input type="hidden" name="csrf" value="<%= it.csrf %>">
    <label>Bereich
      <select name="area_id" required>
        <% it.areas.forEach(function(a){ %>
          <option value="<%= a.id %>" <%= String(a.id) === String(it.shift.area_id) ? 'selected' : '' %>><%= a.name %></option>
        <% }) %>
      </select>
    </label>
    <label>Titel (optional) <input name="title" value="<%= it.shift.title || '' %>"></label>
    <label>Beginn <input type="datetime-local" name="starts_at" value="<%= it.shift.starts_at %>" required></label>
    <label>Ende <input type="datetime-local" name="ends_at" value="<%= it.shift.ends_at %>" required></label>
    <label>Plätze <input type="number" min="1" name="capacity" value="<%= it.shift.capacity %>" required></label>
    <label class="checkbox"><input type="checkbox" name="is_orga" value="1" <%= it.shift.is_orga ? 'checked' : '' %>> Orgaschicht (unter /orga, mit Telefonnummer)</label>
    <label class="checkbox"><input type="checkbox" name="requires_phone" value="1" <%= it.shift.requires_phone ? 'checked' : '' %>> Telefonnummer Pflicht</label>
    <label>Notiz <input name="notes" value="<%= it.shift.notes || '' %>"></label>
    <details class="en-fields"<%= (it.shift.title_en || it.shift.notes_en) ? ' open' : '' %>>
      <summary>English (optional)</summary>
      <p class="hint">Wird angezeigt, wenn jemand die Seite auf Englisch stellt. Leer lassen = deutscher Text.</p>
      <label>Title <input name="title_en" value="<%= it.shift.title_en || '' %>" maxlength="500"></label>
      <label>Note <input name="notes_en" value="<%= it.shift.notes_en || '' %>" maxlength="500"></label>
    </details>
    <button type="submit">Speichern</button>
    <a href="/admin">Abbrechen</a>
  </form>
</div>
