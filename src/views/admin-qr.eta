<div class="admin">
  <%~ include('admin-back', { t: it.t, heading: it.t('qr.title') }) %>
  <div class="qr-page">
    <p><%= it.t('qr.target') %> <code><%= it.url %></code></p>
    <img src="<%= it.dataUrl %>" alt="QR-Code" class="qr-img">
    <p><a href="/admin/qr.svg" download="helfer-qr.svg"><%= it.t('qr.download') %></a></p>
    <p class="hint"><%= it.t('qr.hint') %></p>
  </div>
</div>
